Checks: >
  -*,
  bugprone-*,
  clang-analyzer-*,
  modernize-avoid-c-arrays,
  modernize-deprecated-headers,
  modernize-loop-convert,
  modernize-make-unique,
  modernize-use-auto,
  modernize-use-emplace,
  modernize-use-equals-default,
  modernize-use-nullptr,
  modernize-use-override,
  performance-*,
  portability-*,
  readability-function-size,
  readability-identifier-naming
WarningsAsErrors: '*'
HeaderFilterRegex: '.*[\\/]SpareNode[\\/](apps|include|src|tests)[\\/].*'
FormatStyle: file
# Keep project policy explicit so analyzer upgrades cannot silently change the
# accepted complexity and naming conventions.
CheckOptions:
  bugprone-easily-swappable-parameters.MinimumLength: 2
  bugprone-easily-swappable-parameters.ModelImplicitConversions: true
  bugprone-easily-swappable-parameters.QualifiersMix: false
  bugprone-easily-swappable-parameters.SuppressParametersUsedTogether: true
  readability-function-size.BranchThreshold: 10
  readability-function-size.LineThreshold: 80
  readability-function-size.NestingThreshold: 4
  readability-function-size.ParameterThreshold: 5
  readability-function-size.StatementThreshold: 80
  readability-function-size.VariableThreshold: 20
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.EnumConstantCase: lower_case
  readability-identifier-naming.FunctionCase: lower_case
  readability-identifier-naming.MethodCase: lower_case
  readability-identifier-naming.NamespaceCase: lower_case
  readability-identifier-naming.ParameterCase: lower_case
  readability-identifier-naming.PrivateMemberCase: lower_case
  readability-identifier-naming.PrivateMemberSuffix: _
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.TemplateParameterCase: CamelCase
  readability-identifier-naming.TypeAliasCase: CamelCase
  readability-identifier-naming.VariableCase: lower_case
