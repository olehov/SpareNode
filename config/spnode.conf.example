# SpareNode persistent configuration format example.
# Start SpareNode with: sparenode --config /path/to/spnode.conf
server {
    bind "0.0.0.0";
    port 8080;
    multithreading true;
    worker_threads 4;
    log_level "info";
    # Relative paths are resolved from the directory containing this file.
    mime_types_file "mime.types";
    # Receive inactivity and total request budgets, in milliseconds.
    header_timeout_ms 10000;
    body_timeout_ms 10000;
    request_timeout_ms 30000;

    location "/api/Documents" {
        # Replace this placeholder with an existing directory before starting SpareNode.
        path "/absolute/path/to/files";
        read true;
        write false;
        delete false;
    }
}
